{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDM",
  "identifier": "app.opendm.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "webui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenDM — Download Manager",
        "width": 1000,
        "height": 680,
        "minWidth": 780,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
