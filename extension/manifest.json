{
  "manifest_version": 3,
  "name": "OpenDM Integration",
  "version": "1.7.0",
  "description": "OpenDM browser integration - context menus, media buttons and download takeover.",
  "key": "",
  "minimum_chrome_version": "109",
  "permissions": ["nativeMessaging", "downloads", "contextMenus", "storage", "webRequest", "cookies", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["*://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }],
  "action": { "default_title": "OpenDM" },
  "icons": {
    "16": "icons/logo16.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  }
}
